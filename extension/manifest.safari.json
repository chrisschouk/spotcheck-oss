{
  "manifest_version": 2,
  "name": "SpotCheck: Spotify Playlist Bot Checker",
  "version": "1.1.0",
  "description": "See if a Spotify playlist shows bot-farm patterns, right on the page. Free, no account. Open source.",
  "permissions": [
    "https://open.spotify.com/*",
    "https://spotcheck.cc/*"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background/service-worker.js"
    ],
    "persistent": false
  },
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/playlist/*"
      ],
      "js": [
        "content/spotify-injector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    "icons/*",
    "lib/check-result.js",
    "lib/ui-format.js"
  ]
}
